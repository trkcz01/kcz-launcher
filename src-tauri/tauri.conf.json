{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KÇZ Launcher",
  "version": "0.0.89",
  "identifier": "com.kcz.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "KCZ Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://mc-heads.net https://textures.minecraft.net https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRjVCMzgyMzlGOTc1QzIKUldUQ2RmazVnclAxMG9uRjk0Q1g2a0htTTg3WXBuVnNvNklxQ0lvU3JwNmNSNjVndmZ2dmdnekMK",
      "endpoints": ["https://github.com/trkcz01/kcz-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
